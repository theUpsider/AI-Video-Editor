# .env.example — the environment variables the AI Video Editor reads, with their purposes.
# Copy to .env (gitignored; Claude Code is denied reading it) and set only what you need.
# Never commit a real value. ./scripts/verify.sh needs none of these: tests run on fakes.
# scripts/probe-environment.sh reports each credential below as set or unset, never its value.
# docs/ENVIRONMENT_CAPABILITIES.md § External gaps names the action that unblocks each live test.

# --- Runtime paths and tools (optional) ---------------------------------------------------------
# Root of runtime data, render outputs and test artifacts (backend/src/ave/paths.py).
# Default: the repository's gitignored var/ directory.
AVE_VAR_DIR=
# Absolute paths of the FFmpeg and FFprobe executables (backend/src/ave/proc.py).
# Default: resolved from PATH.
AVE_FFMPEG=
AVE_FFPROBE=

# --- AI provider credentials (optional; manual editing and CPU export work without them) --------
# Anthropic API key for the Anthropic Messages adapter (AVE-REQ-050) and the Claude Agent runtime
# adapter (AVE-REQ-051). Obtain it at console.anthropic.com → API keys. The coding session's own
# login is never a product credential (baseline ASM-15).
ANTHROPIC_API_KEY=
# API key of an OpenAI or OpenAI-compatible chat endpoint (AVE-REQ-050; translation through the
# text provider, AVE-REQ-060). Obtain it in the provider's console (OpenAI: platform.openai.com →
# API keys).
OPENAI_API_KEY=
# Base URL of an OpenAI-compatible endpoint (AVE-REQ-050). Empty: the OpenAI API.
OPENAI_BASE_URL=
# Hugging Face access token with read scope, for gated model downloads through the model registry
# (AVE-REQ-053); public models download without it. Obtain it at huggingface.co → Settings →
# Access Tokens.
HF_TOKEN=
# The Codex runtime adapter (AVE-REQ-052) uses the authentication the Codex SDK documents; its
# variable joins this file with the adapter (M5).
